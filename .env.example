# Database Configuration
MONGODB_URI="mongodb+srv://your-username:your-password@your-cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourAppName"
MONGO_DBNAME="residencia"

# Google Services
GOOGLE_API_KEY="your-google-api-key-here"

# NextAuth Configuration
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# AI Services
GROQ_API_KEY="your-groq-api-key-here"

# Base URL for Application (used in email links)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
BASE_URL="https://your-app.vercel.app"

# HuggingFace (optional)
# HUGGING_FACE_API_KEY="your-hugging-face-api-key-here"

# Email Configuration (for motivational emails)
EMAIL_FROM="mentor@residencia.edu"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password-here"
EMAIL_SECURE="false"

# SMTP Configuration for Email Verification
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-here"

# Security Token for Cron Jobs
CRON_SECRET_TOKEN="your-secure-cron-token-here"

